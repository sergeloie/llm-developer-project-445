// Политики write-пути агента мобильного оператора (Dogwood: Cedar + temporal).
// Всё запрещено по умолчанию: разрешает только роль клиента с tariffs:write,
// подтверждение той же карточки и лимит в две смены тарифа за сессию.

@id("prepare_write_card")
permit (
    principal,
    action == Tel::Action::"Prepare",
    resource
)
when {
    context.input.role == "client"
    && context.input.scopes.contains("tariffs:write")
    && context.input.guard_ok == true
};

// «Да» — только по карточке, которая готовилась в этом окне.
@id("confirm_prepared_card")
permit (
    principal,
    action == Tel::Action::"ConfirmCard",
    resource
)
when { context.input.guard_ok == true }
when temporal {
    formerly within 1h Tel::Action::"Prepare"::request{
        input.pending_id: context.input.pending_id,
        input.sub: context.input.sub
    }
};

// Исполнение — только после «да» по той же карточке.
@id("execute_confirmed_card")
permit (
    principal,
    action == Tel::Action::"Execute",
    resource
)
when { context.input.guard_ok == true }
when temporal {
    formerly within 1h Tel::Action::"ConfirmCard"::request{
        input.pending_id: context.input.pending_id,
        input.sub: context.input.sub
    }
};

// Лимит: третья смена тарифа за сессию запрещена. Услуги и контакты
// не расходуют лимит — forbid смотрит только на tariff_change.
// tariff_changes_done — факт сервиса: сколько Execute уже разрешено.
// Отклонённые запросы (confirmation_missing и т.п.) лимит не тратят.
@id("tariff_change_session_limit")
forbid (
    principal,
    action == Tel::Action::"Execute",
    resource
)
when {
    context.input.action == "tariff_change"
    && context.input.tariff_changes_done >= 2
};
